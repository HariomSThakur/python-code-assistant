# App settings
APP_ENV=development
SECRET_KEY=
DATABASE_PATH=assistant.sqlite3

# Optional initial administrator. Use a password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional model: choose ollama or openai. Without a configured model, the UI
# uses local rules and curated examples.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Keep the model loaded between requests; uses memory while it stays loaded.
OLLAMA_KEEP_ALIVE=10m
# Lower limits can return faster, shorter answers. Allowed range: 128–2048.
OLLAMA_NUM_PREDICT=1024

# For OpenAI, choose AI_PROVIDER=openai and set both values below.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
